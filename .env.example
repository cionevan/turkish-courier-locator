# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Your production domain routed through Traefik / Dokploy
DOMAIN=kargo.yourdomain.com

# Scraper Concurrency (Parallel network requests)
CONCURRENCY=5

# UI Control: Set to false to disable web interface and run strictly as headless REST API
ENABLE_UI=true

# Search Engine Indexing: Set to false to block Google and web crawlers (Disallow: / & noindex header)
ENABLE_ROBOTS_INDEX=false

# Automatic Nightly Sync Scheduler: Runs full district scan every night at 05:00
ENABLE_CRON=true
CRON_SCHEDULE="0 5 * * *"

# Optional REST API Security Key (If set, requests require 'X-API-KEY' header or '?api_key=' param)
# API_KEY=your_secret_api_key_here
